generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FlowScope {
  ALL_POSTS
  SPECIFIC_POST
}

enum MatchType {
  ANY
  KEYWORD
}

/// A connected Instagram professional account (Instagram login).
model Account {
  id            String    @id @default(cuid())
  igUserId      String    @unique
  username      String?
  accessToken   String?
  /// Instagram login token lasts 60 days; lib/credentials.ts renews it
  tokenExpiraEm DateTime?
  createdAt     DateTime  @default(now())
  flows         Flow[]
}

/// An automation: when a comment matches, run the configured actions.
model Flow {
  id            String        @id @default(cuid())
  name          String
  /// comentario | live | story_resposta | story_mencao | reacao (lib/gatilhos.ts)
  tipo          String        @default("comentario")
  enabled       Boolean       @default(true)
  scope         FlowScope     @default(ALL_POSTS)
  mediaId       String? // only used when scope = SPECIFIC_POST
  matchType     MatchType     @default(ANY)
  keywords      String[]      @default([]) // used when matchType = KEYWORD
  publicReplies String[]      @default([]) // one is picked at random to avoid looking robotic
  dmMessage     String? // comment -> DM simples (private reply); null = sem DM simples
  dmFlow        Json? // fluxo multi-passo com quick replies: { entry, steps: { id: { text, quickReplies } } }
  grafo         Json? // construtor visual: { inicio, nos: [...] } (lib/grafo.ts); quando existe, vale no lugar do dmFlow/dmMessage
  execucoes     Execucao[]
  account       Account?      @relation(fields: [accountId], references: [id])
  accountId     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  logs          ActivityLog[]
}

/// Every comment webhook we receive, stored for dedup and auditing.
model CommentEvent {
  id             String   @id @default(cuid())
  commentId      String   @unique
  mediaId        String?
  fromUserId     String?
  fromUsername   String?
  text           String?
  processed      Boolean  @default(false)
  raw            Json?
  receivedAt     DateTime @default(now())
  /// moderação pelo painel
  ocultado       Boolean  @default(false)
  resolvido      Boolean  @default(false)
  respostaManual String?
}

/// Idempotency ledger for one-shot webhook events (e.g. messaging mids).
model ProcessedEvent {
  id        String   @id @default(cuid())
  key       String   @unique
  createdAt DateTime @default(now())
}

/// Audit log of actions taken (public replies, DMs, errors).
model ActivityLog {
  id        String   @id @default(cuid())
  type      String
  commentId String?
  flow      Flow?    @relation(fields: [flowId], references: [id])
  flowId    String?
  detail    Json?
  createdAt DateTime @default(now())
}

/// Quem interagiu com a conta (comentou ou mandou direct). igsid = o ID que a
/// Meta dá à pessoa (o mesmo no comentário e no direct).
model Contact {
  id            String    @id @default(cuid())
  igsid         String    @unique
  username      String?
  nome          String?
  email         String?
  telefone      String?
  notas         String?
  tags          String[]  @default([])
  /// coluna no quadro de Contatos
  etapa         String    @default("novo")
  /// "atendimento" (você está respondendo) ou "resolvida"
  status        String    @default("resolvida")
  /// bloqueado: some das listas e a automação ignora
  bloqueado     Boolean   @default(false)
  /// última mensagem da pessoa no direct: abre a janela de 24 h da Meta
  ultimaEntrada DateTime?
  ultimaMsg     DateTime?
  lidoEm        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  mensagens     Message[]

  @@index([ultimaMsg])
}

/// Uma mensagem da conversa. direcao: "entrada" (da pessoa) ou "saida".
/// origem: "pessoa", "comentario" (o comentário que abriu a conversa),
/// "automacao", "humano" (enviada pelo painel) ou "instagram" (pelo app).
model Message {
  id        String   @id @default(cuid())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId String
  mid       String?  @unique
  direcao   String
  origem    String
  texto     String
  createdAt DateTime @default(now())

  @@index([contactId, createdAt])
}

/// O sino do painel: o que merece aviso. "chave" impede aviso repetido
/// quando a Meta reentrega o mesmo evento.
model Notificacao {
  id        String   @id @default(cuid())
  /// mensagem | comentario | fluxo | reconexao | contato
  tipo      String
  titulo    String
  destaque  String?
  texto     String
  link      String?
  /// novo | concluido | atencao
  etiqueta  String?
  chave     String?  @unique
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Preferências do painel guardadas no banco (ex.: primeiros passos dispensados).
model Configuracao {
  chave String @id
  valor String
}

/// Uma pessoa andando pelo grafo de uma automação (construtor visual).
/// status: andando | aguardando (botão) | espera (atraso) | coleta | concluida | parada_janela | erro
model Execucao {
  id           String    @id @default(cuid())
  flow         Flow      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  flowId       String
  igsid        String
  commentId    String?
  /// a resposta privada ao comentário só pode ser usada uma vez
  privadaUsada Boolean   @default(false)
  noAtual      String?
  status       String    @default("andando")
  proximaEm    DateTime?
  erro         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  cliques      Clique[]

  @@index([status, proximaEm])
  @@index([igsid, status])
}

/// Link rastreado (/r/:id): cada link mandado pelo construtor vira um, e o clique fica gravado.
model Clique {
  id         String    @id @default(cuid())
  execucao   Execucao? @relation(fields: [execucaoId], references: [id], onDelete: SetNull)
  execucaoId String?
  igsid      String?
  flowId     String?
  url        String
  cliques    Int       @default(0)
  primeiroEm DateTime?
  createdAt  DateTime  @default(now())

  @@index([igsid])
}
