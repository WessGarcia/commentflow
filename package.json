{
  "name": "commentflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:typed": "eslint -c eslint.typed.config.mjs src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:rules": "node scripts/verify-quality-rules.mjs ./eslint-rules/index.cjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run verify:rules",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@prisma/client": "^6.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.511.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "prisma": "^6.2.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
